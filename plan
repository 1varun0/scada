    TEL --> PE["Physics Consistency Engine<br/>(Digital Twin)"]
    TEL --> TE["Temporal Behavior Engine<br/>(LSTM-Autoencoder)"]
    TEL --> POL["Command/Policy Safety Engine<br/>(Deterministic Rules)"]
    TEL --> AE["Communication Integrity Engine<br/>(Availability Monitor)"]
    PE --> FUS["Hybrid Fusion Engine"]
    TE --> FUS
